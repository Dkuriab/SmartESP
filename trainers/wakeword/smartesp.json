{
  "id": "wakeword",
  "title": "Слово пробуждения",
  "description": "Модель для колонки (microWakeWord): на какие слова просыпаться. Каждая цель — отдельная модель; на колонку ставится одна, лучшая по замерам.",
  "record_hint": "Говори как обычно зовёшь Кузю. Меняй место в комнате (от полуметра до трёх метров), громкость и интонацию; иногда — с шумом вокруг.",
  "targets": [
    {
      "id": "kuzya",
      "title": "Кузя",
      "positive": [
        "Кузя",
        "Кузьма"
      ],
      "negative": [
        "Кузов",
        "Кузнец",
        "Кузина",
        "Гуся",
        "Дуся",
        "Муся",
        "Вася",
        "Ксюша",
        "Куда",
        "Пузо",
        "Узя",
        "Музыка"
      ]
    },
    {
      "id": "hey_kuzya",
      "title": "Эй, Кузя",
      "positive": [
        "Эй, Кузя"
      ],
      "negative": [
        "Кузя",
        "Эй",
        "Эй, Вася",
        "Эй, Гуся",
        "Кузов",
        "Кузнец",
        "Ксюша",
        "Музыка"
      ]
    }
  ],
  "steps": [
    {
      "id": "download",
      "title": "Скачать данные",
      "hint": "Один раз: качает ~7 ГБ, на диске ~25 ГБ — готовые примеры «не слово» и фоновые шумы",
      "per_target": false,
      "args": [
        "download"
      ]
    },
    {
      "id": "synth",
      "title": "Синтетика",
      "hint": "Фразы цели голосами ядра, ~10 минут",
      "per_target": true,
      "args": [
        "synth",
        "--target",
        "{target}"
      ]
    },
    {
      "id": "train",
      "title": "Обучить",
      "hint": "Признаки и обучение, около часа",
      "per_target": true,
      "args": [
        "train",
        "--target",
        "{target}"
      ]
    },
    {
      "id": "embed",
      "title": "Встроить в прошивку",
      "hint": "Модель последнего прогона → прошивка; прошить колонку по USB",
      "per_target": false,
      "args": [
        "embed",
        "--run",
        "last"
      ]
    }
  ],
  "command": [
    "uv",
    "run",
    "--project",
    "{kit}",
    "wakeword",
    "--json"
  ]
}
